APP_NAME="Bangladesh Local Guides"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_PORT=80

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: host uid/gid for bind-mount file ownership (Linux/macOS hosts).
DOCKER_UID=1000
DOCKER_GID=1000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bdlg
DB_USERNAME=bdlg
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
FORWARD_DB_PORT=13306

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
# Must exceed the longest job timeout (SyncLocalGuide: 240s)
REDIS_QUEUE_RETRY_AFTER=330
LG_SYNC_PROCESSES=2

CACHE_STORE=redis
CACHE_PREFIX=bdlg

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@bdlocalguides.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage. Dev: MinIO. Prod: AWS S3 (+ CloudFront in AWS_URL).
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bdlg
AWS_ENDPOINT=http://minio:9000
# Public base URL for files under public/ (browser-reachable). Prod: https://cdn.example.com
AWS_URL=http://localhost:9000/bdlg
AWS_USE_PATH_STYLE_ENDPOINT=true

# Admin seeded by `make fresh`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_NAME="BDLG Admin"

# Scraper (see config/localguides.php)
LG_SYNC_PER_MINUTE=4
LG_SYNC_WAIT_MS=4000
LG_SYNC_TIMEOUT=45
LG_SYNC_JITTER_MIN=5
LG_SYNC_JITTER_MAX=15
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
BROWSERSHOT_NODE_MODULES=/usr/local/lib/node_modules

# Optional server-side (Browsershot) frame renderer
FEATURE_SERVER_RENDER=false
RENDER_INTERNAL_URL=http://nginx
# Dev: Chromium in Docker loads Vite assets from the vite container
BROWSERSHOT_HOST_RULES="MAP localhost vite"

VITE_APP_NAME="${APP_NAME}"
