# Production template — copy to .env on the server and fill in real secrets.
APP_NAME="Bangladesh Local Guides"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bdlocalguides.example.org
APP_PORT=80
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bdlg
DB_USERNAME=bdlg
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

CACHE_STORE=redis
CACHE_PREFIX=bdlg
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=330
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@bdlocalguides.example.org"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 + CloudFront. Bucket policy: allow public read on the "public/" prefix only.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=bdlg-prod
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# CloudFront distribution in front of the bucket (used for og:image and public files)
AWS_URL=https://dxxxxxxxxxxxx.cloudfront.net
# Optional: serve /build assets from a CDN as well
ASSET_URL=

ADMIN_EMAIL=admin@bdlocalguides.example.org
ADMIN_PASSWORD=

LG_SYNC_PER_MINUTE=4
LG_SYNC_PROCESSES=2
LG_SYNC_WAIT_MS=4000
LG_SYNC_TIMEOUT=45
LG_SYNC_JITTER_MIN=5
LG_SYNC_JITTER_MAX=15
BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
BROWSERSHOT_NODE_MODULES=/usr/local/lib/node_modules

FEATURE_SERVER_RENDER=false
RENDER_INTERNAL_URL=http://nginx
BROWSERSHOT_HOST_RULES=

VITE_APP_NAME="${APP_NAME}"
